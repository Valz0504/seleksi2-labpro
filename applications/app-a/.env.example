# App A reads the root .env automatically during local pnpm scripts.
# This file documents the subset required by App A when it is deployed alone.
AUTH_SERVER_PUBLIC_URL=http://localhost:3001
AUTH_SERVER_INTERNAL_URL=http://localhost:3001

# Confidential OAuth client; never prefix the secret with NEXT_PUBLIC_.
APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=replace-with-random-client-secret
APP_A_REDIRECT_URI=http://localhost:3002/auth/callback
APP_A_LAUNCH_URL=http://localhost:3002
LOCAL_SESSION_TTL_SECONDS=28800

# Standalone deployment override. Root-level local development derives this
# connection from LOCAL_DB_USER, LOCAL_DB_PASSWORD, and LOCAL_DB_PORT.
APP_A_DATABASE_URL=postgresql://postgres:replace-with-local-db-password@localhost:5433/app_a
