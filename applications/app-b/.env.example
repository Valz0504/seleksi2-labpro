# App B reads the root .env automatically during local pnpm scripts.
# This file documents the subset required by App B when it is deployed alone.
AUTH_SERVER_PUBLIC_URL=http://localhost:3001
AUTH_SERVER_INTERNAL_URL=http://localhost:3001

# Confidential OAuth client; never prefix the secret with NEXT_PUBLIC_.
APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=replace-with-random-client-secret
APP_B_REDIRECT_URI=http://localhost:3003/auth/callback
APP_B_LAUNCH_URL=http://localhost:3003
LOCAL_SESSION_TTL_SECONDS=28800

# Bearer credential used only by trusted back-channel callers such as Sync Worker.
INTERNAL_SERVICE_SECRET=replace-with-random-internal-service-secret

# Standalone deployment override. Root-level local development derives this
# connection from LOCAL_DB_USER, LOCAL_DB_PASSWORD, and LOCAL_DB_PORT.
APP_B_DATABASE_URL=postgresql://postgres:replace-with-local-db-password@localhost:5433/app_b
