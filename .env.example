# Service ports
CONTROL_PANEL_PORT=3000
AUTH_SERVER_PORT=3001
APP_A_PORT=3002
APP_B_PORT=3003
SYNC_WORKER_PORT=3004

# Primary database
PRIMARY_DB_USER=postgres
PRIMARY_DB_PASSWORD=postgres
PRIMARY_DB_NAME=auth_provider
PRIMARY_DB_PORT=5432

# Local database
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_PORT=5433

# RabbitMQ
RABBITMQ_USER=sso_dev
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application secrets
SSO_COOKIE_SECRET=replace-with-random-secret
INTERNAL_SERVICE_SECRET=replace-with-random-secret

# Development seed only; replace before starting Compose
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
