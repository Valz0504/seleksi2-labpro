# Service ports
CONTROL_PANEL_PORT=3000
AUTH_SERVER_PORT=3001
APP_A_PORT=3002
APP_B_PORT=3003
SYNC_WORKER_PORT=3004

# Primary database
PRIMARY_DB_USER=postgres
PRIMARY_DB_PASSWORD=postgres
PRIMARY_DB_NAME=auth_provider
PRIMARY_DB_PORT=5432

# Local database
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_PORT=5433

# RabbitMQ
RABBITMQ_USER=sso_dev
RABBITMQ_PASSWORD=replace-with-local-rabbitmq-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OUTBOX_PUBLISHER_ENABLED=true
RABBITMQ_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_HEARTBEAT_SECONDS=10
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=10000
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=50
OUTBOX_PUBLISH_LEASE_MS=30000
OUTBOX_PUBLISH_RETRY_BASE_MS=1000
OUTBOX_PUBLISH_RETRY_MAX_MS=60000
SYNC_WORKER_CONSUMER_ENABLED=true
DELIVERY_RETRY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_MS=1000
DELIVERY_RETRY_MAX_MS=60000
# Host-only development: translate Docker service hostnames stored by the seed.
SYNC_WORKER_LOGOUT_HOST_OVERRIDE=localhost

# Graceful shutdown (Compose allows 15 seconds before SIGKILL)
SHUTDOWN_TIMEOUT_MS=10000

# Application secrets
SSO_COOKIE_SECRET=replace-with-random-secret
INTERNAL_SERVICE_SECRET=replace-with-random-secret

# Development seed only; replace before starting Compose
SEED_ADMIN_PASSWORD=replace-with-local-admin-password

# OAuth clients used by the Auth Provider seed and the matching app backend.
# Client secrets remain server-only and must never use a NEXT_PUBLIC_ prefix.
APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=replace-with-random-client-secret
APP_A_REDIRECT_URI=http://localhost:3002/auth/callback
APP_A_LAUNCH_URL=http://localhost:3002
APP_A_LOGOUT_NOTIFICATION_URL=http://app-a:3002/internal/logout

APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=replace-with-random-client-secret
APP_B_REDIRECT_URI=http://localhost:3003/auth/callback
APP_B_LAUNCH_URL=http://localhost:3003
APP_B_LOGOUT_NOTIFICATION_URL=http://app-b:3003/internal/logout

# Central session and OAuth lifetimes
SSO_COOKIE_NAME=sso_session
SSO_COOKIE_SECURE=false
SSO_SESSION_TTL_SECONDS=28800
AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
LOCAL_SESSION_TTL_SECONDS=28800

# Interactive Auth Provider OpenAPI documentation at /docs
SWAGGER_ENABLED=true

# Browser-facing SSO URLs
AUTH_LOGIN_URL=http://localhost:3000/login
AUTH_SERVER_PUBLIC_URL=http://localhost:3001
CONTROL_PANEL_ADMIN_LOGIN_URL=http://localhost:3000/admin/login
CONTROL_PANEL_ADMIN_DASHBOARD_URL=http://localhost:3000/admin
