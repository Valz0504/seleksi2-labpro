# Use localhost and the host port configured by PRIMARY_DB_PORT when the server runs outside Docker.
DATABASE_URL=postgresql://postgres:replace-with-local-db-password@localhost:5432/auth_provider

# Transactional-outbox publisher (host process -> Docker RabbitMQ port)
RABBITMQ_URL=amqp://sso_dev:replace-with-local-rabbitmq-password@localhost:5672
OUTBOX_PUBLISHER_ENABLED=true
RABBITMQ_CONNECTION_TIMEOUT_MS=5000
RABBITMQ_HEARTBEAT_SECONDS=10
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=10000
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=50
OUTBOX_PUBLISH_LEASE_MS=30000
OUTBOX_PUBLISH_RETRY_BASE_MS=1000
OUTBOX_PUBLISH_RETRY_MAX_MS=60000

# Development bootstrap admin
SEED_ADMIN_PASSWORD=replace-with-local-admin-password

# Auth Provider secrets
SSO_COOKIE_SECRET=replace-with-random-secret
INTERNAL_SERVICE_SECRET=replace-with-random-secret

# OAuth clients seeded into the Auth Provider
APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=replace-with-random-client-secret
APP_A_REDIRECT_URI=http://localhost:3002/auth/callback
APP_A_LAUNCH_URL=http://localhost:3002
APP_A_LOGOUT_NOTIFICATION_URL=http://app-a:3002/internal/logout

APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=replace-with-random-client-secret
APP_B_REDIRECT_URI=http://localhost:3003/auth/callback
APP_B_LAUNCH_URL=http://localhost:3003
APP_B_LOGOUT_NOTIFICATION_URL=http://app-b:3003/internal/logout

# Central session and OAuth lifetimes
SSO_COOKIE_NAME=sso_session
SSO_COOKIE_SECURE=false
SSO_SESSION_TTL_SECONDS=28800
AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900

# Interactive OpenAPI documentation at /docs
SWAGGER_ENABLED=true

# Browser-facing login page used to continue /authorize
AUTH_LOGIN_URL=http://localhost:3000/login
CONTROL_PANEL_ADMIN_LOGIN_URL=http://localhost:3000/admin/login
CONTROL_PANEL_ADMIN_DASHBOARD_URL=http://localhost:3000/admin
