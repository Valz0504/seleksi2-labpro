# Use localhost and the host port configured by PRIMARY_DB_PORT when the server runs outside Docker.
DATABASE_URL=postgresql://postgres:replace-with-local-db-password@localhost:5432/auth_provider

# Development bootstrap admin
SEED_ADMIN_PASSWORD=replace-with-local-admin-password

# Auth Provider secrets
SSO_COOKIE_SECRET=replace-with-random-secret
INTERNAL_SERVICE_SECRET=replace-with-random-secret

# OAuth clients seeded into the Auth Provider
APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=replace-with-random-client-secret
APP_A_REDIRECT_URI=http://localhost:3002/auth/callback
APP_A_LAUNCH_URL=http://localhost:3002
APP_A_LOGOUT_NOTIFICATION_URL=http://app-a:3002/internal/logout

APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=replace-with-random-client-secret
APP_B_REDIRECT_URI=http://localhost:3003/auth/callback
APP_B_LAUNCH_URL=http://localhost:3003
APP_B_LOGOUT_NOTIFICATION_URL=http://app-b:3003/internal/logout
