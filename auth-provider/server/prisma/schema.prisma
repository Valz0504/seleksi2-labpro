// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  USER
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum PolicyEffect {
  ALLOW
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AccessTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PkceCodeChallengeMethod {
  S256
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  email        String              @unique
  passwordHash String              @map("password_hash")
  status       UserStatus          @default(ACTIVE)
  role         UserRole            @default(USER)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  userGroups   UserGroup[]
  ssoSessions  SsoSession[]
  authCodes    AuthorizationCode[]
  accessTokens AccessToken[]

  @@map("users")
}

model Group {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @unique
  description String?                  @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  userGroups  UserGroup[]
  policies    ApplicationGroupPolicy[]

  @@map("groups")
}

model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

model Application {
  id                    String                   @id @default(uuid()) @db.Uuid
  name                  String
  clientId              String                   @unique @map("client_id")
  clientSecretHash      String?                  @map("client_secret_hash")
  status                ApplicationStatus        @default(ACTIVE)
  launchUrl             String?                  @map("launch_url") @db.Text
  logoutNotificationUrl String                   @map("logout_notification_url") @db.Text
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  redirectUris          ApplicationRedirectUri[]
  groupPolicies         ApplicationGroupPolicy[]
  authCodes             AuthorizationCode[]
  accessTokens          AccessToken[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  redirectUri   String      @map("redirect_uri") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, redirectUri])
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  effect        PolicyEffect @default(ALLOW)
  createdAt     DateTime     @default(now()) @map("created_at")
  application   Application  @relation(fields: [applicationId], references: [id])
  group         Group        @relation(fields: [groupId], references: [id])

  @@unique([applicationId, groupId, effect])
  @@index([groupId])
  @@map("application_group_policies")
}

model SsoSession {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  sessionTokenHash String              @unique @map("session_token_hash")
  status           SessionStatus       @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  expiresAt        DateTime            @map("expires_at")
  lastActivityAt   DateTime?           @map("last_activity_at")
  revokedAt        DateTime?           @map("revoked_at")
  revokeReason     String?             @map("revoke_reason")
  ipAddress        String?             @map("ip_address") @db.VarChar(45)
  userAgent        String?             @map("user_agent") @db.Text
  user             User                @relation(fields: [userId], references: [id])
  authCodes        AuthorizationCode[]
  accessTokens     AccessToken[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sso_sessions")
}

model AuthorizationCode {
  id                  String                  @id @default(uuid()) @db.Uuid
  codeHash            String                  @unique @map("code_hash")
  userId              String                  @map("user_id") @db.Uuid
  applicationId       String                  @map("application_id") @db.Uuid
  ssoSessionId        String                  @map("sso_session_id") @db.Uuid
  redirectUri         String                  @map("redirect_uri") @db.Text
  codeChallenge       String                  @map("code_challenge")
  codeChallengeMethod PkceCodeChallengeMethod @default(S256) @map("code_challenge_method")
  createdAt           DateTime                @default(now()) @map("created_at")
  expiresAt           DateTime                @map("expires_at")
  usedAt              DateTime?               @map("used_at")
  user                User                    @relation(fields: [userId], references: [id])
  application         Application             @relation(fields: [applicationId], references: [id])
  ssoSession          SsoSession              @relation(fields: [ssoSessionId], references: [id])

  @@index([ssoSessionId, usedAt])
  @@index([expiresAt])
  @@map("authorization_codes")
}

model AccessToken {
  id            String            @id @default(uuid()) @db.Uuid
  tokenHash     String            @unique @map("token_hash")
  userId        String            @map("user_id") @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  ssoSessionId  String            @map("sso_session_id") @db.Uuid
  scopes        Json?
  status        AccessTokenStatus @default(ACTIVE)
  issuedAt      DateTime          @default(now()) @map("issued_at")
  expiresAt     DateTime          @map("expires_at")
  revokedAt     DateTime?         @map("revoked_at")
  user          User              @relation(fields: [userId], references: [id])
  application   Application       @relation(fields: [applicationId], references: [id])
  ssoSession    SsoSession        @relation(fields: [ssoSessionId], references: [id])

  @@index([userId, status])
  @@index([applicationId, status])
  @@index([ssoSessionId, status])
  @@index([expiresAt])
  @@map("access_tokens")
}
