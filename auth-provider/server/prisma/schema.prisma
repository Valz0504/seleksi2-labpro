// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

generator syncWorkerClient {
  provider     = "prisma-client"
  output       = "../../sync-worker/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum PolicyEffect {
  ALLOW
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AccessTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PkceCodeChallengeMethod {
  S256
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
}

enum EventDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
}

enum MfaLoginIntent {
  API
  OAUTH
  ADMIN
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  passwordHash       String              @map("password_hash")
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  userGroups         UserGroup[]
  ssoSessions        SsoSession[]
  authCodes          AuthorizationCode[]
  accessTokens       AccessToken[]
  auditLogsAsActor   AuditLog[]          @relation("AuditLogActor")
  auditLogsAsTarget  AuditLog[]          @relation("AuditLogTargetUser")
  outboxEvents       OutboxEvent[]
  mfaTotp            UserMfaTotp?
  mfaLoginChallenges MfaLoginChallenge[]
  mfaRecoveryCodes   MfaRecoveryCode[]

  @@map("users")
}

model UserMfaTotp {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  secretIv         Bytes     @map("secret_iv")
  secretAuthTag    Bytes     @map("secret_auth_tag")
  enabledAt        DateTime? @map("enabled_at")
  lastUsedTimeStep BigInt?   @map("last_used_time_step")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa_totp")
}

model MfaLoginChallenge {
  id           String         @id @default(uuid()) @db.Uuid
  tokenHash    String         @unique @map("token_hash")
  userId       String         @map("user_id") @db.Uuid
  intent       MfaLoginIntent
  returnTo     String?        @map("return_to") @db.Text
  attemptCount Int            @default(0) @map("attempt_count")
  expiresAt    DateTime       @map("expires_at")
  usedAt       DateTime?      @map("used_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("mfa_login_challenges")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model Group {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @unique
  description String?                  @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  userGroups  UserGroup[]
  policies    ApplicationGroupPolicy[]

  @@map("groups")
}

model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

model Application {
  id                    String                   @id @default(uuid()) @db.Uuid
  name                  String
  clientId              String                   @unique @map("client_id")
  clientSecretHash      String?                  @map("client_secret_hash")
  status                ApplicationStatus        @default(ACTIVE)
  launchUrl             String?                  @map("launch_url") @db.Text
  logoutNotificationUrl String                   @map("logout_notification_url") @db.Text
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  redirectUris          ApplicationRedirectUri[]
  groupPolicies         ApplicationGroupPolicy[]
  authCodes             AuthorizationCode[]
  accessTokens          AccessToken[]
  auditLogs             AuditLog[]
  targetedOutboxEvents  OutboxEvent[]
  eventDeliveries       EventDelivery[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  redirectUri   String      @map("redirect_uri") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, redirectUri])
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  effect        PolicyEffect @default(ALLOW)
  createdAt     DateTime     @default(now()) @map("created_at")
  application   Application  @relation(fields: [applicationId], references: [id])
  group         Group        @relation(fields: [groupId], references: [id])

  @@unique([applicationId, groupId, effect])
  @@index([groupId])
  @@map("application_group_policies")
}

model SsoSession {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  sessionTokenHash String              @unique @map("session_token_hash")
  status           SessionStatus       @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  expiresAt        DateTime            @map("expires_at")
  lastActivityAt   DateTime?           @map("last_activity_at")
  revokedAt        DateTime?           @map("revoked_at")
  revokeReason     String?             @map("revoke_reason")
  ipAddress        String?             @map("ip_address") @db.VarChar(45)
  userAgent        String?             @map("user_agent") @db.Text
  user             User                @relation(fields: [userId], references: [id])
  authCodes        AuthorizationCode[]
  accessTokens     AccessToken[]
  auditLogs        AuditLog[]
  outboxEvents     OutboxEvent[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sso_sessions")
}

model AuthorizationCode {
  id                  String                  @id @default(uuid()) @db.Uuid
  codeHash            String                  @unique @map("code_hash")
  userId              String                  @map("user_id") @db.Uuid
  applicationId       String                  @map("application_id") @db.Uuid
  ssoSessionId        String                  @map("sso_session_id") @db.Uuid
  redirectUri         String                  @map("redirect_uri") @db.Text
  codeChallenge       String                  @map("code_challenge")
  codeChallengeMethod PkceCodeChallengeMethod @default(S256) @map("code_challenge_method")
  createdAt           DateTime                @default(now()) @map("created_at")
  expiresAt           DateTime                @map("expires_at")
  usedAt              DateTime?               @map("used_at")
  user                User                    @relation(fields: [userId], references: [id])
  application         Application             @relation(fields: [applicationId], references: [id])
  ssoSession          SsoSession              @relation(fields: [ssoSessionId], references: [id])

  @@index([ssoSessionId, usedAt])
  @@index([expiresAt])
  @@map("authorization_codes")
}

model AccessToken {
  id            String            @id @default(uuid()) @db.Uuid
  tokenHash     String            @unique @map("token_hash")
  userId        String            @map("user_id") @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  ssoSessionId  String            @map("sso_session_id") @db.Uuid
  scopes        Json?
  status        AccessTokenStatus @default(ACTIVE)
  issuedAt      DateTime          @default(now()) @map("issued_at")
  expiresAt     DateTime          @map("expires_at")
  revokedAt     DateTime?         @map("revoked_at")
  user          User              @relation(fields: [userId], references: [id])
  application   Application       @relation(fields: [applicationId], references: [id])
  ssoSession    SsoSession        @relation(fields: [ssoSessionId], references: [id])

  @@index([userId, status])
  @@index([applicationId, status])
  @@index([ssoSessionId, status])
  @@index([expiresAt])
  @@map("access_tokens")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type")
  actorId       String?      @map("actor_id") @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  sessionId     String?      @map("session_id") @db.Uuid
  result        String
  metadata      Json?
  ipAddress     String?      @map("ip_address") @db.VarChar(45)
  createdAt     DateTime     @default(now()) @map("created_at")
  actor         User?        @relation("AuditLogActor", fields: [actorId], references: [id])
  user          User?        @relation("AuditLogTargetUser", fields: [userId], references: [id])
  application   Application? @relation(fields: [applicationId], references: [id])
  session       SsoSession?  @relation(fields: [sessionId], references: [id])

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([applicationId, createdAt])
  @@index([sessionId])
  @@map("audit_logs")
}

model OutboxEvent {
  id                   String            @id @default(uuid()) @db.Uuid
  eventType            String            @map("event_type") @db.VarChar(100)
  userId               String            @map("user_id") @db.Uuid
  centralSessionId     String?           @map("central_session_id") @db.Uuid
  applicationId        String?           @map("application_id") @db.Uuid
  payload              Json
  status               OutboxEventStatus @default(PENDING)
  publishAttemptCount  Int               @default(0) @map("publish_attempt_count")
  lastPublishAttemptAt DateTime?         @map("last_publish_attempt_at")
  nextPublishAttemptAt DateTime?         @map("next_publish_attempt_at")
  lastError            String?           @map("last_error") @db.Text
  createdAt            DateTime          @default(now()) @map("created_at")
  publishedAt          DateTime?         @map("published_at")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  centralSession       SsoSession?       @relation(fields: [centralSessionId], references: [id], onDelete: SetNull)
  application          Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  deliveries           EventDelivery[]

  @@index([status, nextPublishAttemptAt, createdAt])
  @@index([userId, createdAt])
  @@index([centralSessionId])
  @@index([applicationId, createdAt])
  @@map("events")
}

model EventDelivery {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @map("event_id") @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  status        EventDeliveryStatus @default(PENDING)
  attemptCount  Int                 @default(0) @map("attempt_count")
  lastAttemptAt DateTime?           @map("last_attempt_at")
  nextRetryAt   DateTime?           @map("next_retry_at")
  processedAt   DateTime?           @map("processed_at")
  lastError     String?             @map("last_error") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  event         OutboxEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([eventId, applicationId])
  @@index([status, nextRetryAt])
  @@index([applicationId, status])
  @@map("event_deliveries")
}
