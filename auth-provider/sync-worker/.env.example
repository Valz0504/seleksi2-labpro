# Host development can reuse ../server/.env for these shared values. Copy this
# file to .env only when the worker needs a standalone configuration.
DATABASE_URL=postgresql://postgres:replace-with-primary-db-password@localhost:5432/auth_provider
RABBITMQ_URL=amqp://sso_dev:replace-with-rabbitmq-password@localhost:5672
INTERNAL_SERVICE_SECRET=replace-with-random-internal-service-secret

SYNC_WORKER_CONSUMER_ENABLED=true
DELIVERY_RETRY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_MS=1000
DELIVERY_RETRY_MAX_MS=60000
# Omit inside Docker; use localhost when the worker runs on the host while the
# application URLs in Primary DB contain Docker service hostnames.
SYNC_WORKER_LOGOUT_HOST_OVERRIDE=localhost
